generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Propiedad {
  id          Int      @id @default(autoincrement())
  titulo      String
  operacion   String
  tipo        String
  precio      String
  ubicacion   String
  dormitorios Int
  banos       Int
  imagen      String
  descripcion String?  // <--- NUEVO CAMPO AGREGADO
  corredora   String   @default("MGPropiedades")
  createdAt   DateTime @default(now())
}

model Usuario {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  nombre   String? // <--- Nuevo
  rol      String  @default("corredor") // <--- Nuevo (admin o corredor)
}